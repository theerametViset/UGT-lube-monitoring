# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider (Phase P2 only — server-only)
AI_PROVIDER=glm
AI_API_KEY=
AI_MODEL=glm-5.2

# Demo Mode (no Supabase): preview every module; writes are blocked
# DEMO_MODE=true
# Local Store: with DEMO_MODE, really save Data Entry readings + lab files to
# .local-data/ (one machine only, no login; ignored on Vercel). Download them as
# SQL for Supabase / a company Postgres server at /api/local-store/export.
# LOCAL_STORE=true
# LOCAL_DATA_DIR=
